# Frontend environment variables
# Copy to .env.local and fill in your values

# URL of the deployed backend (trailing slash is optional)
VITE_API_URL=http://localhost:3001

# N8N webhook URL for Edge mock registrations
VITE_N8N_WEBHOOK_URL=https://n8n.nanaska.com/webhook/edge-mock-registration

# Google reCAPTCHA v3 site key (public). Leave blank to disable captcha checks.
# Pair it with RECAPTCHA_SECRET_KEY in backend/.env – both must be from the same key pair.
VITE_RECAPTCHA_SITE_KEY=
