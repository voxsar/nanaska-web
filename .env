# Frontend local environment variables
# Keep this aligned with .env.example
VITE_API_URL=http://localhost:3001

# Google reCAPTCHA v3 site key. Public by design, but keep the real value out of
# this committed file – put it in .env.local (gitignored) for local dev, and in
# the Netlify environment for production.
VITE_RECAPTCHA_SITE_KEY=
